# Normalize all text files to LF in the repo and in every checkout, whatever
# the OS. eol=lf overrides core.autocrlf, so Git for Windows checks out LF and
# no longer warns "LF will be replaced by CRLF". Per-file rules below win.
* text=auto eol=lf

# Binary formats: never convert line endings or diff them as text.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.ico    binary
*.icns   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.otf    binary
*.pdf    binary
*.wav    binary
*.mp3    binary
*.m4a    binary
*.mp4    binary
*.zip    binary
*.exe    binary
*.dll    binary

libs/cert-prep-api/src/lib/cert-prep-api.generated.ts text eol=lf
apps/cert-prep-desktop/test-fixtures/capture-document-v1.schema.json text eol=crlf
pnpm-lock.yaml text eol=lf
