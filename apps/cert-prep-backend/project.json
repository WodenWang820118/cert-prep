{
  "name": "cert-prep-backend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/cert-prep-backend/src",
  "tags": ["scope:cert", "type:backend"],
  "targets": {
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": { "cwd": "apps/cert-prep-backend", "command": "uv run uvicorn --app-dir src cert_prep_backend.api.app:create_app --factory --host 127.0.0.1 --port 8765" }
    },
    "test": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/coverage/apps/cert-prep-backend"],
      "options": { "cwd": "apps/cert-prep-backend", "command": "uv run pytest" }
    },
    "lint": {
      "cache": true,
      "executor": "nx:run-commands",
      "inputs": ["default"],
      "options": { "cwd": "apps/cert-prep-backend", "command": "uv run ruff check ." }
    },
    "build-backend-runtime": {
      "cache": true,
      "parallelism": false,
      "executor": "nx:run-commands",
      "inputs": ["production"],
      "outputs": ["{projectRoot}/dist/backend-runtime"],
      "options": {
        "cwd": "apps/cert-prep-backend",
        "env": { "UV_LINK_MODE": "copy" },
        "command": "uv run --isolated --python 3.12 python scripts/build_backend_runtime.py --target x86_64-pc-windows-msvc --version 0.1.0-alpha.1"
      }
    },
    "generate-openapi-client": {
      "cache": true,
      "parallelism": false,
      "executor": "nx:run-commands",
      "inputs": ["default"],
      "outputs": ["{workspaceRoot}/libs/cert-prep-api/src/lib/cert-prep-api.generated.ts"],
      "options": {
        "cwd": "apps/cert-prep-backend",
        "command": "uv run python scripts/generate_openapi_client.py --output ../../libs/cert-prep-api/src/lib/cert-prep-api.generated.ts"
      }
    }
  }
}
